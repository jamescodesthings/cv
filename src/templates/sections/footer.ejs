<footer class="site-footer">
  <div class="footer-inner">
    <img
      src="assets/logo/logo.svg"
      alt="codesthings"
      class="footer-logo footer-logo--light"
      width="160"
      loading="lazy"
    />
    <img
      src="assets/logo/logo-dark.svg"
      alt=""
      class="footer-logo footer-logo--dark"
      width="160"
      loading="lazy"
      aria-hidden="true"
    />
    <p class="footer-cv">
      <a href="./assets/<%= encodeURIComponent(sidebar.name) %>.pdf" class="footer-link">
        <span class="cv-icon"><%- include('../../assets/svg/cv.svg') %></span>View CV
      </a>
      <span class="footer-sep" aria-hidden="true">&middot;</span>
      <a
        href="./assets/<%= encodeURIComponent(sidebar.name) %>-no-cover.pdf"
        class="footer-link"
        aria-label="View CV without cover letter"
        >without cover letter</a
      >
    </p>
    <span class="footer-copy">&copy; 2026 James Macmillan</span>
  </div>
</footer>
