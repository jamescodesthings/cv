<section class="section" data-animate>
  <div class="section-inner">
    <span class="section-label">02 - Skills</span>
    <h2 class="section-title">Skills</h2>

    <div class="skills-meta">
      <% sidebar.stacks.forEach(paragraph => { %>
      <p><%= paragraph %></p>
      <% }); %>
    </div>

    <div class="skill-groups">
      <% skills.forEach(group => { %>
      <div class="skill-group">
        <h3 class="skill-group-name"><%= group.name %></h3>
        <p class="skill-group-summary"><%= group.summary %></p>
        <div class="tech-badges">
          <% group.skills.forEach(skill => { %>
          <span class="badge<%= skill.core ? ' badge--core' : '' %>">
            <% if (skill.iconType === 'image') { %>
            <img src="assets/icons/<%= skill.icon.split('/').pop() %>" alt="" class="badge-icon-img" />
            <% } else if (skill.icon) { %>
            <i class="<%= skill.icon %> badge-icon"></i>
            <% } %> <%= skill.name %>
          </span>
          <% }); %>
        </div>
      </div>
      <% }); %>
    </div>

    <div class="education-section">
      <span class="section-label">03 - Education</span>
      <h2 class="section-title">Education</h2>

      <div class="education-grid">
        <% education.forEach(entry => { %>
        <div class="education-card">
          <div class="education-header">
            <h3 class="education-institution"><%= entry.institution %></h3>
            <span class="education-dates"> <%= formatDate(entry.from) %> - <%= formatDate(entry.to) %> </span>
          </div>
          <% entry.qualifications.forEach(qual => { %>
          <div class="qualification">
            <span class="qualification-title"><%= qual.title %></span>
            <% if (qual.aside) { %>
            <span class="qualification-aside"><%= qual.aside %></span>
            <% } %>
          </div>
          <% }); %>
        </div>
        <% }); %>
      </div>
    </div>

    <div class="interests-section">
      <span class="section-label">04 - Outside work</span>
      <% sidebar.interests.forEach(paragraph => { %>
      <p><%- paragraph %></p>
      <% }); %>
    </div>
  </div>
</section>
